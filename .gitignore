# Environment / secrets — this repo is public
.env
.env.local
.env.*.local

# Claude Code local state (settings.local.json, launch.json, worktrees) — never commit
.claude/

# The owner's content never goes in this public repo:
# the 2026-09-23 snapshot, frozen (#6, #7), and any later ones
/snapshot/
/snapshot.partial/
/snapshots/
# the working copy: its own repo, pushed to a private one (#7)
/work/

# Windows artifact: a stray `> nul` in Git Bash writes a literal file named nul
nul

# Dependencies and build output
__pycache__/
node_modules/
dist/
build/
.cache/

# Logs
*.log
npm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.DS_Store
Thumbs.db
desktop.ini
